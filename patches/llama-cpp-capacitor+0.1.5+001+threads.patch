+// ─── Threads de calcul ───────────────────────────────────────────────────────
+// Nombre de threads par défaut, utilisé seulement quand l'appelant ne fournit
+// pas la clé `n_threads`.
+//
+// POURQUOI CE DÉFAUT EXISTE : `common_params::cpuparams.n_threads` vaut -1 au
+// départ (common.h:55) et RIEN dans ce plugin ne l'écrivait. Or -1 ne veut pas
+// dire « laisse ggml choisir » : la valeur traversait
+// `common_context_params_to_llama` (common.cpp:1154) sous la forme
+// `cparams.n_threads = -1`, puis `llama_context::graph_compute`
+// (llama-context.cpp:1415) la poussait au backend CPU, où `lm_ggml_graph_plan`
+// la remplaçait par la constante LM_GGML_DEFAULT_N_THREADS = 4
+// (ggml-cpu.c:2665-2667, ggml.h:228). Le calcul tournait donc à 4 threads sur
+// n'importe quelle machine — 4 sur un 8 cœurs. On écrit ici une valeur RÉELLE.
+//
+// LA VALEUR : la moitié des processeurs logiques, bornée à [1, 6]. Sur un
+// big.LITTLE (1+3+4, 4+4, 2+6…), la moitié ≈ le cluster de performance. Ne PAS
+// prendre tous les cœurs est délibéré : ggml découpe le travail de l'étape en
+// `n_threads` parts et attend TOUS ses threads à la barrière de fin
+// (lm_ggml_graph_compute_kickoff / lm_ggml_graph_compute_thread, ggml-cpu.c),
+// donc un seul thread posé sur un petit cœur retarde l'étape entière. La même
+// règle, pour la même raison, est appliquée côté JS (`nbThreadsCalcul` dans
+// src/ai/moteurNatif.ts) ; c'est la valeur de l'appelant qui gagne dès qu'elle
+// est fournie.
+static int nb_threads_par_defaut() {
+    unsigned int logiques = std::thread::hardware_concurrency();
+    int n = logiques > 0 ? static_cast<int>(logiques) : 4;
+    int base = (n <= 4) ? n : (n / 2);
+    if (base < 1) base = 1;
+    if (base > 6) base = 6;
+    return base;
+}
