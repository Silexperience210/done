--- a/node_modules/llama-cpp-capacitor/android/src/main/java/ai/annadata/plugin/capacitor/LlamaCpp.java
+++ b/node_modules/llama-cpp-capacitor/android/src/main/java/ai/annadata/plugin/capacitor/LlamaCpp.java
@@ -257,6 +257,39 @@ public class LlamaCpp {
         this.context = context;
     }
 
+    // ─── FLUX DE JETONS VERS L'ÉCOUTEUR JS (@LlamaCpp_onToken) ───────────────
+    // Côté JS, `LlamaContext.completion(params, callback)` enregistre un
+    // écouteur `@LlamaCpp_onToken` (dist/esm/index.js:8,260) et attend un corps
+    // `{ contextId, tokenResult }`. Rien, avant ce correctif, n'émettait cet
+    // évènement : le natif ne rappelait jamais Java et personne n'appelait
+    // `notifyListeners`. Le flux de jetons était donc définitivement muet.
+    public interface TokenListener {
+        void onToken(int contextId, String tokenText);
+    }
+
+    private volatile TokenListener tokenListener;
+
+    public void setTokenListener(TokenListener listener) {
+        this.tokenListener = listener;
+    }
+
+    // APPELÉE PAR LE NATIF (jni.cpp, completionNative) une fois par jeton
+    // généré, sur le fil JNI de l'appel. Elle retrouve l'identifiant JS du
+    // contexte à partir de son identifiant natif, puis remonte le jeton.
+    public void onTokenFromNative(long nativeContextId, String tokenText) {
+        TokenListener listener = this.tokenListener;
+        if (listener == null) {
+            return;
+        }
+        for (Map.Entry<Integer, LlamaContext> entry : contexts.entrySet()) {
+            LlamaContext ctx = entry.getValue();
+            if (ctx != null && ctx.getNativeContextId() == nativeContextId) {
+                listener.onToken(entry.getKey(), tokenText);
+                return;
+            }
+        }
+    }
+
     // Native method declarations
     private native long initContextNative(String modelPath, String[] searchPaths, JSObject params);
     private native void releaseContextNative(long nativeContextId);
@@ -569,6 +602,25 @@ public class LlamaCpp {
     }
 
     public void releaseAllContexts(LlamaCallback<Void> callback) {
+        // Libérer VRAIMENT le natif, contexte par contexte.
+        //
+        // `contexts.clear()` seul ne vidait que la table Java : chaque modèle
+        // restait chargé dans la table C++ de jni.cpp (`contexts`, un
+        // `std::map<long, unique_ptr<llama_cap_context>>`). Un modèle entier —
+        // ses poids, sa KV — fuitait donc à chaque changement de modèle. On
+        // reproduit ici, pour CHAQUE contexte, ce que fait `releaseContext`
+        // (releaseContextNative + retrait), avant de vider la table Java.
+        try {
+            for (Integer key : new ArrayList<>(contexts.keySet())) {
+                LlamaContext context = contexts.get(key);
+                if (context != null && context.getNativeContextId() >= 0) {
+                    releaseContextNative(context.getNativeContextId());
+                }
+            }
+        } catch (Exception e) {
+            callback.onResult(LlamaResult.failure(new LlamaError("Failed to release all contexts: " + e.getMessage())));
+            return;
+        }
         contexts.clear();
         callback.onResult(LlamaResult.success(null));
     }
diff --git a/node_modules/llama-cpp-capacitor/android/src/main/java/ai/annadata/plugin/capacitor/LlamaCppPlugin.java b/node_modules/llama-cpp-capacitor/android/src/main/java/ai/annadata/plugin/capacitor/LlamaCppPlugin.java
index f2d7628..7e3c5c0 100644
--- a/node_modules/llama-cpp-capacitor/android/src/main/java/ai/annadata/plugin/capacitor/LlamaCppPlugin.java
+++ b/node_modules/llama-cpp-capacitor/android/src/main/java/ai/annadata/plugin/capacitor/LlamaCppPlugin.java
@@ -28,6 +28,21 @@ public class LlamaCppPlugin extends Plugin {
         super.load();
         // Initialize implementation with context
         implementation = new LlamaCpp(getContext());
+        // Relier le flux de jetons natif à l'évènement JS `@LlamaCpp_onToken`.
+        // C'est ICI que le pont se ferme : le natif (jni.cpp) appelle
+        // `LlamaCpp.onTokenFromNative`, qui remonte ici, et `notifyListeners`
+        // émet l'évènement que le JS écoute. Le corps attendu est
+        // `{ contextId, tokenResult }`, avec `tokenResult.token`
+        // (dist/esm/index.js:260-265 ; consommé par src/ai/moteurNatif.ts).
+        // Sans cette liaison, l'écouteur JS ne recevait jamais rien.
+        implementation.setTokenListener((contextId, tokenText) -> {
+            JSObject tokenResult = new JSObject();
+            tokenResult.put("token", tokenText);
+            JSObject data = new JSObject();
+            data.put("contextId", contextId);
+            data.put("tokenResult", tokenResult);
+            notifyListeners("@LlamaCpp_onToken", data);
+        });
         Log.i(TAG, "LlamaCppPlugin loaded successfully");
     }
 
