+static void diag_preparer(const std::string & dossier) {
+    g_diag_dir = dossier;
+    const std::string chemin = g_diag_dir + "/journal-natif.txt";
+    FILE * f = fopen(chemin.c_str(), "w"); // un chargement = une trace, pas un cumul
+    if (f != nullptr) {
+        fclose(f);
+    }
+}
+
+static void diag(const char * fmt, ...) {
+    if (g_diag_dir.empty()) {
+        return;
+    }
+    const std::string chemin = g_diag_dir + "/journal-natif.txt";
+    FILE * f = fopen(chemin.c_str(), "a");
+    if (f == nullptr) {
+        return;
+    }
+    const auto maintenant = std::chrono::system_clock::now();
+    const std::time_t t = std::chrono::system_clock::to_time_t(maintenant);
+    const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                        maintenant.time_since_epoch()) % 1000;
+    struct tm tm_buf;
+    localtime_r(&t, &tm_buf);
+    char h[32];
+    strftime(h, sizeof(h), "%H:%M:%S", &tm_buf);
+    fprintf(f, "[%s.%03d] ", h, static_cast<int>(ms.count()));
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(f, fmt, ap);
+    va_end(ap);
+    fputc('\n', f);
+    fclose(f);
+}
